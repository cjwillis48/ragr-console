# ragr-console environment.
#
# Production values live in the Cloudflare Pages dashboard
# (ragr-console -> Settings -> Environment variables -> Production), NOT in this
# repo. This file documents the contract; copy it to .env for local dev.

# Base URL of the ragr API.
#   local dev  http://localhost:8000
#   production https://api.ragr.dev
# Read at RUNTIME by the console via $env/dynamic/public (src/lib/admin-api.ts),
# so changing it in Pages takes effect without a rebuild. It is ALSO inlined at
# BUILD time into the embeddable widget bundle (vite.widget.config.ts ->
# src/widget/config.ts), so the widget only picks up a new value on a rebuild.
PUBLIC_RAGR_API_URL=http://localhost:8000

# Clerk. The publishable key encodes the frontend-API domain, so it changes
# whenever the Clerk instance's domain changes. The secret key does not.
# These are consumed by svelte-clerk itself rather than by our own source, so
# they will not show up in a grep of src/.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_UP_URL=/sign-up
PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# Comma-separated model slugs surfaced on /demos.
PUBLIC_DEMO_SLUGS=chatlie,hades-bot,barkley

# Optional. Pins the widget loader to an immutable hashed bundle
# (/widget/ragr-chat.<sha>.js) instead of the unversioned file. Must match the
# git short SHA of the deploy that built it, or the loader points at a bundle
# that does not exist. Unset = serve /widget/ragr-chat.js (Cache-Control 300s).
# PUBLIC_WIDGET_SHA=

# Optional. Structured logging; src/lib/axiom.ts no-ops if either is unset.
# AXIOM_TOKEN=
# AXIOM_DATASET=ragr-console

# Optional. Only used by scripts/capture-og.mjs to regenerate static/og.png.
# OG_URL=http://localhost:5173/
